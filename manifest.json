{
  "manifest_version": 3,
  "name": "X One-Click Mute",
  "version": "1.1.0",
  "description": "X（Twitter）のポストのアクションバーに「ミュート」と「このポストに興味がない」のワンクリックボタンを追加します。",
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
